# =============================================================================
# Flake8 Configuration
# =============================================================================

[flake8]
max-line-length = 100
max-complexity = 10
select = E,F,W,C,B,B950
extend-ignore =
    E203,
    E266,
    E501,
    W503,
    F403,
    F401,
exclude =
    .git,
    .gitignore,
    .mypy_cache,
    .pytest_cache,
    .tox,
    .venv,
    venv,
    __pycache__,
    *.egg-info,
    build,
    dist,
    migrations,
    .eggs
per-file-ignores =
    __init__.py:F401
    tests/*:S101,D103
docstring-convention = google
